<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Camada de Aplicação — casos de uso.
    Depende apenas do Domínio e de abstrações (logging/DI). Não conhece EF Core,
    MongoDB, ASP.NET nem JWT: tudo isso chega por interfaces (Dependency Inversion).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <RootNamespace>Clyvo.PetCare.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clyvo.PetCare.Domain\Clyvo.PetCare.Domain.csproj" />
  </ItemGroup>

</Project>
