<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Camada de Infraestrutura — detalhes técnicos que implementam os contratos
    do Domínio/Aplicação: EF Core + Oracle (relacional), MongoDB (NoSQL),
    JWT, hash de senha, seed e health checks.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <RootNamespace>Clyvo.PetCare.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hosting, Options, HealthChecks e PasswordHasher (Identity.Core) vêm do shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Persistência relacional — EF Core + Oracle -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="8.23.60" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.10" />

    <!-- Persistência NoSQL — MongoDB -->
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />

    <!-- Emissão de tokens JWT -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clyvo.PetCare.Application\Clyvo.PetCare.Application.csproj" />
  </ItemGroup>

</Project>
