<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Camada de Apresentação (composition root): controllers REST, HATEOAS,
    autenticação JWT, tratamento global de exceções, Swagger e observabilidade.
    Referencia Application (casos de uso) e Infrastructure (somente para o DI).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <RootNamespace>Clyvo.PetCare.Api</RootNamespace>
    <AssemblyName>Clyvo.PetCare.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Necessário apenas para o "dotnet ef" usar esta API como startup project -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Autenticação JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />

    <!-- Swagger / OpenAPI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.6.2" />

    <!-- Logging estruturado — Serilog -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />

    <!-- Health Checks (formato JSON do HealthChecks UI) -->
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="8.0.1" />

    <!-- OpenTelemetry — tracing e métricas -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.0.0-beta.12" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" Version="0.5.0-beta.7" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.9.0-beta.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clyvo.PetCare.Application\Clyvo.PetCare.Application.csproj" />
    <ProjectReference Include="..\Clyvo.PetCare.Infrastructure\Clyvo.PetCare.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Torna a classe Program visível para os testes de integração (WebApplicationFactory) -->
    <InternalsVisibleTo Include="Clyvo.PetCare.IntegrationTests" />
  </ItemGroup>

</Project>
