<?xml version="1.0" encoding="utf-8"?>
<!-- Cobertura de codigo (coverlet). Uso: veja a secao "Testes automatizados" do README. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Clyvo.PetCare.Domain]*,[Clyvo.PetCare.Application]*,[Clyvo.PetCare.Infrastructure]*,[Clyvo.PetCare.Api]*</Include>
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
